# ==================================================
# WATERSCOPE - Environment Configuration Template
# ==================================================

# Database Configuration (PostgreSQL + PostGIS or SQLite fallback)
DATABASE_URL=sqlite:///./data/waterscope.db
# For production PostgreSQL / PostGIS:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/waterscope

# Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["*"]

# Machine Learning Service Contract
ML_SERVICE_URL=http://localhost:8000
FPCD_DATASET_ID=ctundia/FPCD
FPCD_LOCAL_PATH=./data/fpcd
DATASET_AUTO_SYNC=true

# Satellite Data Providers
DEMO_MODE=true
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_STAC_URL=https://catalogue.dataspace.copernicus.eu/stac
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
SENTINEL_HUB_INSTANCE_ID=

# Indian National Remote Sensing Centre (NRSC) / Bhuvan
BHUVAN_API_TOKEN=
SRISHTI_DRISHTI_ENABLED=false
SRISHTI_DRISHTI_BASE_URL=https://bhuvan-app1.nrsc.gov.in/api
SRISHTI_DRISHTI_API_KEY=

# Ancillary Environmental APIs
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
IMD_API_BASE_URL=https://mausam.imd.gov.in/api
OPENAI_API_KEY=

# Storage Paths
UPLOAD_DIR=./data/uploads
THUMBNAIL_DIR=./data/uploads/thumbnails
REPORT_DIR=./data/reports
CACHE_DIR=./data/cache
